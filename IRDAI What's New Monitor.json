    {
      "parameters": {
        "jsCode": "const html = $input.first().json.data;\n\n// Extract the DLFileEntryArray JSON from the HTML\nconst varIndex = html.indexOf('var DLFileEntryArray = ');\nconst arrayStart = varIndex + 'var DLFileEntryArray = '.length;\nconst arrayEnd = html.indexOf('];', arrayStart) + 1;\nconst arrayJson = html.substring(arrayStart, arrayEnd);\n\n// Parse the JSON array\nconst entries = JSON.parse(arrayJson);\n\n// Map to clean output with document URL\nconst results = entries.map(entry => ({\n  json: {\n    date: entry.dateId,\n    title: entry.title,\n    category: entry.subTitle,\n    url: `https://irdai.gov.in/web/guest/document-detail?documentId=${entry.fileentryId}`,\n    fileentryId: entry.fileentryId,\n    source: 'IRDAI'\n  }\n}));\n\nreturn results;"
      },
