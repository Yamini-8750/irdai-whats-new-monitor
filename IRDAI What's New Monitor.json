    {
      "parameters": {
        "jsCode": "// Get all items fetched from IRDAI\nconst fetchedItems = $('Code in JavaScript').all().map(item => item.json);\n\n// Get already seen IDs from sheet (empty array if sheet is empty)\nlet seenIds = [];\ntry {\n  const sheetItems = $('Get row(s) in sheet').all();\n  seenIds = sheetItems\n    .filter(item => item.json && item.json.fileentryId)\n    .map(item => String(item.json.fileentryId));\n} catch(e) {\n  seenIds = [];\n}\n\n// Filter only NEW items\nconst newItems = fetchedItems.filter(item => \n  !seenIds.includes(String(item.fileentryId))\n);\n\nif (newItems.length === 0) {\n  return [{ json: { noNewItems: true, message: 'No new IRDAI updates today' } }];\n}\n\nreturn newItems.map(item => ({ json: item }));"
      },
