    {
      "parameters": {
        "jsCode": "// Combine all new items into one email\nconst items = $input.all().map(i => i.json);\n\nconst itemList = items.map((item, index) => \n  `${index + 1}. ${item.date} | ${item.category}\n   ${item.title}\n   Link: ${item.url || 'https://irdai.gov.in/web/guest/whats-new'}\n`).join('\\n');\n\nconst emailBody = `New IRDAI Updates Detected (${items.length} new items)\n\n${itemList}\n\n---\nThis email was sent automatically by Beshak Monitor`;\n\nreturn [{\n  json: {\n    count: items.length,\n    subject: `🔔 IRDAI: ${items.length} New Update(s) Detected`,\n    body: emailBody,\n    items: items\n  }\n}];"
      },
